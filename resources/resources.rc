#include "winres.h"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  Booty Catalog Windows Resource File
//  ALL game data, HTML, CSS, JS, icons embedded as RCDATA
//  Location: F:\study\projects\pirate-catalog
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ━━━ Icon resources ━━━
3001 RTICON "booty.ico"
3002 RTICON "tray.ico"
3003 RTICON "tray.ico"        // tray downloading state

// ━━━ Binary blob resources (generated by embed_resources.py) ━━━
1001 RCDATA "games.bin"
1002 RCDATA "html.bin"
1003 RCDATA "css.bin"
1004 RCDATA "js.bin"
1005 RCDATA "jsdl.bin"
1006 RCDATA "icon.bin"
1007 RCDATA "tray.bin"

// ━━━ Rating dialog ━━━
6000 DIALOGEX 0, 0, 200, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rate Game"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 50, 58, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 105, 58, 50, 14
    LTEXT           "Click stars to rate:", -1, 20, 10, 160, 12
END

// ━━━ Application version ━━━
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Booty Catalog"
      VALUE "FileDescription",  "The ultimate pirate game catalog — one-click download"
      VALUE "InternalName",     "BootyCatalog"
      VALUE "LegalCopyright",   "Michaelunkai (C) 2025"
      VALUE "OriginalFilename", "BootyCatalog.exe"
      VALUE "ProductName",      "Booty Catalog"
      VALUE "FileVersion",      "1.0.0"
      VALUE "ProductVersion",   "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
